{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "viper-ph",
  "main": "dist/_worker.js/index.js",
  "compatibility_date": "2026-10-19",
  "compatibility_flags": ["global_fetch_strictly_public"],
  "observability": {
    "enabled": true
  },
  "assets": {
    "binding": "ASSETS",
    "directory": "dist"
  },
  "r2_buckets": [
    {
      "binding": "MEDIA",
      "bucket_name": "media"
    }
  ]
}
