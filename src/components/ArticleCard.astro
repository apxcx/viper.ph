---
import type { Article } from '../data/articles';
import { migratedStory } from '../data/posts';

interface Props {
  article: Article;
  featured?: boolean;
  compact?: boolean;
}

const { featured = false, compact = false } = Astro.props;
const article = migratedStory(Astro.props.article);
const categoryPaths: Record<string, string> = {
  'Tech News': 'tech-news',
  'PH Tech': 'ph-tech',
  'Electric Vehicles': 'electric-vehicles',
  AI: 'ai',
  'Fintech and Banking Tech': 'fintech-banking-tech',
  Products: 'products',
  Gadgets: 'gadgets',
  'E-Commerce': 'e-commerce',
  'E-commerce': 'e-commerce',
  'Apps and Software': 'apps-and-software',
  'International Tech': 'international-tech',
  'Tech Events': 'tech-events',
  'Telcos and Internet': 'telcos-and-internet',
  Auto: 'auto',
};
const categoryHref = `/category/${categoryPaths[article.category] ?? 'tech-news'}/`;
---

<article class:list={['news-card', { 'news-card--featured': featured, 'news-card--compact': compact }]}>
  <a class="news-card__image-link" href={article.href} tabindex="-1" aria-hidden="true">
    <img class="news-card__image" src={article.image} alt="" loading={featured ? 'eager' : 'lazy'} />
    <span class="news-card__arrow" aria-hidden="true">↗</span>
  </a>
  <div class="news-card__body">
    <div class="news-card__meta">
      <span>{article.date}</span><span>{article.time}</span>
    </div>
    <h2><a href={article.href}>{article.title}</a></h2>
    <a class="news-card__category" href={categoryHref}>{article.category}</a>
  </div>
</article>
