---
import type { Article } from '../data/articles';

interface Props {
  article: Article;
  featured?: boolean;
  compact?: boolean;
}

const { article, featured = false, compact = false } = Astro.props;
---

<article class:list={['news-card', { 'news-card--featured': featured, 'news-card--compact': compact }]}>
  <a class="news-card__image-link" href={article.href} aria-label={`Read ${article.title}`}>
    <img class="news-card__image" src={article.image} alt={article.title} loading={featured ? 'eager' : 'lazy'} />
    <span class="news-card__arrow" aria-hidden="true">↗</span>
  </a>
  <div class="news-card__body">
    <div class="news-card__meta">
      <span>{article.date}</span><span>{article.time}</span>
    </div>
    <h2><a href={article.href}>{article.title}</a></h2>
    {!compact && <p>{article.excerpt}</p>}
    <a class="news-card__category" href={`#${article.category.toLowerCase().replaceAll(' ', '-')}`}>{article.category}</a>
  </div>
</article>
