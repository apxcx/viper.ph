---
import BaseLayout from './BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

interface Props {
  frontmatter: {
    title: string;
    description: string;
    canonical: string;
    sourceModified?: string;
  };
}

const { frontmatter } = Astro.props;
const title = frontmatter.title as string;
const description = frontmatter.description as string;
const canonical = frontmatter.canonical as string;
const modified = frontmatter.sourceModified as string | undefined;
const modifiedLabel = modified
  ? new Intl.DateTimeFormat('en-US', { month: 'long', day: 'numeric', year: 'numeric' }).format(new Date(modified))
  : undefined;
---

<BaseLayout title={`${title} | Viper.ph`} description={description} canonical={canonical}>
  <div class="page-shell" id="top">
    <Header />
    <main class="policy-page section-frame">
      <header class="policy-page__header">
        <span class="eyebrow"><span class="eyebrow__dot" aria-hidden="true"></span>Viper.ph / Legal</span>
        <h1>{title}</h1>
        {modifiedLabel && <p class="policy-page__updated">Updated {modifiedLabel}</p>}
      </header>
      <article class="policy-page__content">
        <slot />
      </article>
    </main>
    <Footer />
  </div>
</BaseLayout>
