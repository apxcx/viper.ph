---
import BaseLayout from './BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import BriefingSidebar from '../components/BriefingSidebar.astro';
import ArticleCard from '../components/ArticleCard.astro';
import { manilaDate, relatedPosts, postsBySlug, type ArticleFrontmatter } from '../data/posts';

interface Props {
  frontmatter: ArticleFrontmatter;
}

const { frontmatter } = Astro.props;
const category = frontmatter.categories?.[0] ?? 'Tech News';
const categorySlugs: Record<string, string> = {
  'Tech News': 'tech-news',
  'Electric Vehicles': 'electric-vehicles',
  AI: 'ai',
  'Fintech and Banking Tech': 'fintech-banking-tech',
  Products: 'products',
  'E-Commerce': 'e-commerce',
  'Telcos and Internet': 'telcos-and-internet',
  Auto: 'auto',
};
const categoryHref = `/category/${categorySlugs[category] ?? 'tech-news'}/`;
const canonical = frontmatter.canonical_url ?? `https://viper.ph/${frontmatter.slug}/`;
const image = `/api/media/${frontmatter.featured_image_key}${['cirtek-semiconductor-unit-sale-sancode', 'gcash-ipo-share-price-after-listing', 'ai-election-content-philippine-guardrails', 'philippine-ev-summit-15-brands-2026', 'gbf-class-builder-stem-learning-philippines', 'philippine-business-ai-adoption-2027', 'pagasa-22-radar-weather-network', 'philippine-offshore-wind-hub', 'vivo-v80-philippine-preorders'].includes(frontmatter.slug) ? `?v=${frontmatter.slug === 'vivo-v80-philippine-preorders' ? '202610312' : '20261031'}` : ''}`;
const imageAlt = frontmatter.featured_image_alt?.trim() || frontmatter.title;
const socialImage = new URL(image, 'https://viper.ph').href;
const importedPost = postsBySlug.get(frontmatter.slug);
const validSeoText = (value?: string) => value && !/^(one moment|just a moment|attention required|checking your browser)/i.test(value) ? value : undefined;
const seoTitle = validSeoText(frontmatter.seo_title) ?? `${frontmatter.title} | Viper.ph`;
const description = validSeoText(frontmatter.seo_description) ?? importedPost?.description;
const published = manilaDate(frontmatter.date);
const publishedAt = published.toISOString();
const modifiedAt = frontmatter.modified ? manilaDate(frontmatter.modified).toISOString() : undefined;
const displayDate = new Intl.DateTimeFormat('en-PH', {
  day: 'numeric',
  month: 'long',
  year: 'numeric',
  timeZone: 'Asia/Manila',
}).format(published);
const displayTime = new Intl.DateTimeFormat('en-PH', {
  hour: 'numeric',
  minute: '2-digit',
  hour12: true,
  timeZone: 'Asia/Manila',
}).format(published);
const relatedStories = relatedPosts(frontmatter.slug);
---

<BaseLayout
  title={seoTitle}
  description={description}
  canonical={canonical}
  ogType="article"
  ogTitle={validSeoText(frontmatter.og_title) ?? seoTitle}
  ogDescription={validSeoText(frontmatter.og_description) ?? description}
  ogImage={socialImage}
  ogImageAlt={imageAlt}
  author={frontmatter.author}
  robots={frontmatter.seo_robots}
  publishedTime={publishedAt}
  modifiedTime={modifiedAt}
>
  <div class="page-shell" id="top">
    <Header />

    <nav class="article-breadcrumbs section-frame" aria-label="Breadcrumb">
      <a href={categoryHref}>{category}</a>
      <span aria-hidden="true">/</span>
      <span>Article</span>
    </nav>

    <main class="article-page">
      <header class="article-header section-frame">
        <div class="article-header__category"><a href={categoryHref}>{category}</a><span aria-hidden="true"> / FEATURE</span></div>
        <h1>{frontmatter.title}</h1>
        {description && <p class="article-header__dek">{description}</p>}
        <div class="article-header__meta">
          <span>By {frontmatter.author ?? 'Viper Editorial Team'}</span>
          <time datetime={publishedAt}>{displayDate}</time>
          <span>{displayTime}</span>
        </div>
      </header>

      <div class="article-layout section-frame">
        <div class="article-main-column">
          <figure class="article-cover">
            <img
              src={image}
              alt={imageAlt}
              width={frontmatter.featured_image_width}
              height={frontmatter.featured_image_height}
              loading="eager"
              fetchpriority="high"
            />
          </figure>
          <article class="article-body">
            <slot />
          </article>
        </div>
        <BriefingSidebar id="article-categories" />
      </div>

      <section class="article-related section-frame" aria-labelledby="related-stories-title">
        <div class="section-kicker">
          <h2 class="eyebrow" id="related-stories-title">Related stories</h2>
          <a class="section-link" href={categoryHref}>More in {category} <span aria-hidden="true">↗</span></a>
        </div>
        <div class="article-related__grid">
          {relatedStories.map((story) => <ArticleCard article={story} compact />)}
        </div>
      </section>
    </main>

    <Footer />
  </div>
</BaseLayout>
