---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  canonical?: string;
  ogType?: string;
  ogTitle?: string;
  ogDescription?: string;
  ogImage?: string;
  ogImageAlt?: string;
  author?: string;
  robots?: string;
  publishedTime?: string;
  modifiedTime?: string;
}

const {
  title = 'Viper.ph | Philippine Tech News',
  description = 'Viper.ph is the Philippines’ leading tech news and discovery platform, covering the stories, products, and ideas shaping what comes next.',
  canonical = 'https://viper.ph/',
  ogType = 'website',
  ogTitle = title,
  ogDescription = description,
  ogImage = new URL('/media/viper-logo.webp', canonical).href,
  ogImageAlt = 'Viper.ph',
  author,
  robots,
  publishedTime,
  modifiedTime,
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="theme-color" content="#14171c" />
    <meta name="description" content={description} />
    <meta property="og:type" content={ogType} />
    <meta property="og:title" content={ogTitle} />
    <meta property="og:description" content={ogDescription} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content="Viper.ph" />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:alt" content={ogImageAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={ogTitle} />
    <meta name="twitter:description" content={ogDescription} />
    <meta name="twitter:image" content={ogImage} />
    {author && <meta name="author" content={author} />}
    {robots && <meta name="robots" content={robots} />}
    {publishedTime && <meta property="article:published_time" content={publishedTime} />}
    {modifiedTime && <meta property="article:modified_time" content={modifiedTime} />}
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
  </head>
  <body>
    <slot />
  </body>
</html>
