---
import CategoryArchive from '../../components/CategoryArchive.astro';
import { categoryPages } from '../../data/category-data';

export function getStaticPaths() {
  return categoryPages.map((page) => ({
    params: { category: page.slug },
    props: { page },
  }));
}

const { page } = Astro.props;
---

<CategoryArchive page={page} />
