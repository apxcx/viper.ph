---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import ArticleCard from '../components/ArticleCard.astro';
import { articles } from '../data/articles';
---

<BaseLayout>
  <div class="page-shell" id="top">
    <Header />

    <main>
      <section class="hero section-frame" aria-labelledby="hero-title">
        <div class="hero__eyebrow eyebrow"><span class="eyebrow__dot"></span> Viper Journal / Vol. 01</div>
        <div class="hero__grid">
          <h1 id="hero-title" class="hero__title">For brands<br /><em>with intent.</em></h1>
          <div class="hero__aside">
            <p>Notes on the work behind the work — identity, digital craft, and the decisions that make a brand feel inevitable.</p>
            <a class="text-link" href="#journal">Explore the journal <span aria-hidden="true">↓</span></a>
          </div>
        </div>
        <div class="hero__footer">
          <span>Selected thoughts on making less, mean more.</span>
          <span class="hero__scroll" aria-hidden="true">Scroll to read <span>↓</span></span>
        </div>
      </section>

      <section class="journal section-frame" id="journal" aria-labelledby="journal-title">
        <div class="section-heading reveal">
          <div>
            <span class="eyebrow">01 / The journal</span>
            <h2 id="journal-title">A point of<br /><em>view.</em></h2>
          </div>
          <p>Three short reads on the principles, practices, and quiet details that shape considered digital work.</p>
        </div>

        <div class="article-grid">
          {articles.map((article) => <ArticleCard article={article} />)}
        </div>
      </section>

      <section class="statement section-frame reveal" id="about" aria-labelledby="statement-title">
        <div class="statement__label eyebrow">02 / A small belief</div>
        <div class="statement__copy">
          <h2 id="statement-title">Good work leaves<br />a <em>trace,</em> not a <span class="text-rust">bruise.</span></h2>
          <p>Viper is a small independent practice for brands choosing clarity over volume. We make identities and digital experiences with a little more tension, a little less noise, and a lot of care.</p>
        </div>
      </section>

      <section class="subscribe section-frame reveal" id="subscribe" aria-labelledby="subscribe-title">
        <div class="subscribe__top">
          <span class="eyebrow">03 / Stay in the loop</span>
          <span class="subscribe__mark" aria-hidden="true">✳</span>
        </div>
        <div class="subscribe__grid">
          <h2 id="subscribe-title">A considered note,<br /><em>occasionally.</em></h2>
          <form class="subscribe__form" onsubmit="return false">
            <label for="email">Your email address</label>
            <div class="subscribe__input-wrap">
              <input id="email" name="email" type="email" placeholder="name@studio.com" autocomplete="email" required />
              <button type="submit" aria-label="Join the journal">↗</button>
            </div>
            <p class="subscribe__fineprint">No noise. Just new writing when there is something worth saying.</p>
          </form>
        </div>
      </section>
    </main>

    <footer class="site-footer section-frame">
      <span>© 2026 Viper Journal</span>
      <span>Manila / Everywhere</span>
      <a href="#top">Back to top <span aria-hidden="true">↑</span></a>
    </footer>
  </div>
</BaseLayout>
