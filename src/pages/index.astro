---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import ArticleCard from '../components/ArticleCard.astro';
import BriefingSidebar from '../components/BriefingSidebar.astro';
import Footer from '../components/Footer.astro';
import { leadStories, latestStories } from '../data/articles';
---

<BaseLayout>
  <div class="page-shell" id="top">
    <Header />

    <section class="subscribe-bar section-frame" id="subscribe" aria-labelledby="subscribe-title">
      <div>
        <span class="eyebrow">The Viper briefing</span>
        <h2 id="subscribe-title">Stay ahead of the signal.</h2>
      </div>
      <form class="subscribe-form" data-subscribe-form>
        <label class="sr-only" for="first-name">First name</label>
        <input id="first-name" name="firstName" type="text" placeholder="First name" autocomplete="given-name" required />
        <label class="sr-only" for="email">Email address</label>
        <input id="email" name="email" type="email" placeholder="Email address" autocomplete="email" required />
        <button type="submit">Subscribe <span aria-hidden="true">↗</span></button>
        <p class="form-status" data-form-status aria-live="polite"></p>
      </form>
    </section>

    <main>
      <section class="masthead section-frame" aria-labelledby="hero-title">
        <div class="masthead__eyebrow"><span class="eyebrow__dot"></span> Viper.ph / Daily tech intelligence</div>
        <h1 id="hero-title"><span>The Daily Pulse</span>{' '}<em>of Philippine Tech</em></h1>
        <p class="masthead__intro">The Philippines’ leading tech news and discovery platform. Clear reporting on the products, people, and ideas changing how we live.</p>
      </section>

      <section class="top-stories section-frame" id="top-stories" aria-labelledby="top-stories-title">
        <div class="section-kicker">
          <h2 class="eyebrow" id="top-stories-title">01 / Top stories</h2>
          <span class="section-kicker__date">25 October 2026</span>
        </div>
        <div class="top-stories__grid">
          <ArticleCard article={leadStories[0]} featured />
          <div class="top-stories__side">
            {leadStories.slice(1).map((article) => <ArticleCard article={article} compact />)}
          </div>
        </div>
      </section>

      <section class="latest section-frame" id="latest" aria-labelledby="latest-section-title">
        <div class="section-kicker">
          <h2 class="eyebrow" id="latest-section-title">02 / Latest</h2>
          <a class="section-link" href="#categories">Browse categories <span aria-hidden="true">↗</span></a>
        </div>
        <div class="latest__layout">
          <div class="latest__grid">
            {latestStories.map((article) => <ArticleCard article={article} />)}
          </div>
          <BriefingSidebar />
        </div>
      </section>
    </main>

    <Footer />
  </div>
</BaseLayout>

<script>
  const form = document.querySelector<HTMLFormElement>('[data-subscribe-form]');
  const status = document.querySelector<HTMLElement>('[data-form-status]');

  form?.addEventListener('submit', async (event) => {
    event.preventDefault();
    const button = form.querySelector<HTMLButtonElement>('button');
    const formData = new FormData(form);
    const firstName = String(formData.get('firstName') ?? '');
    const email = String(formData.get('email') ?? '');
    if (button) button.disabled = true;
    if (status) status.textContent = 'Joining…';

    try {
      const response = await fetch('/api/subscribe', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ firstName, email }),
      });
      const result = await response.json();
      if (status) status.textContent = result.message;
      if (result.ok) form.reset();
    } catch {
      if (status) status.textContent = 'Something went wrong. Please try again.';
    } finally {
      if (button) button.disabled = false;
    }
  });
</script>
