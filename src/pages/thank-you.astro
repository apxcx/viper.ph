---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

const title = 'Thank You for Subscribing | Viper.ph';
const description = 'Your Viper.ph newsletter subscription was successful. Stay updated with the latest Philippine tech news, insights, and analysis.';
const canonical = 'https://viper.ph/thank-you/';
---

<BaseLayout title={title} description={description} canonical={canonical} ogTitle={title} ogDescription={description}>
  <div class="page-shell" id="top">
    <Header />

    <main class="thank-you-page">
      <section class="thank-you-page__panel section-frame" aria-labelledby="thank-you-title">
        <div class="thank-you-page__icon" aria-hidden="true">
          <svg viewBox="0 0 24 24" role="presentation"><path d="m5 12.5 4.2 4.2L19.5 6.5" /></svg>
        </div>
        <span class="eyebrow">The Viper Briefing / Confirmed</span>
        <h1 id="thank-you-title">Thank You for <em>Subscribing!</em></h1>
        <p class="thank-you-page__message">You've successfully subscribed to our newsletter. We're excited to keep you updated with the latest news, insights, and updates. Keep an eye on your inbox!</p>
        <div class="thank-you-page__actions">
          <a class="form-button" href="/">Back to Home <span aria-hidden="true">↗</span></a>
          <a class="thank-you-page__secondary-link" href="/#latest">Explore the latest articles <span aria-hidden="true">↗</span></a>
        </div>
      </section>
    </main>

    <Footer />
  </div>
</BaseLayout>
