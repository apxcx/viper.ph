{
  "name": "viperblog",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.25.0",
  "scripts": {
    "dev": "astro dev --host 0.0.0.0 --port 3000",
    "build": "astro build",
    "preview": "astro preview --host 0.0.0.0",
    "check": "astro check",
    "publisher:index": "python3 scripts/build-publisher-index.py",
    "publisher:manifest": "python3 scripts/generate-publisher-manifest.py",
    "publisher:routes": "python3 scripts/refresh-public-routes.py",
    "publisher:check": "python3 scripts/validate-astro-publisher.py --network",
    "publisher:prepare": "pnpm publisher:index && pnpm publisher:manifest && pnpm publisher:routes && pnpm publisher:check",
    "publisher:publish": "python3 scripts/publish-astro-article.py"
  },
  "dependencies": {
    "@astrojs/check": "latest",
    "@tailwindcss/vite": "4.1.18",
    "astro": "5.18.2",
    "tailwindcss": "latest",
    "typescript": "6.0.3"
  },
  "devDependencies": {
    "@astrojs/cloudflare": "12.6.13",
    "@types/node": "22.19.15",
    "wrangler": "4.59.2"
  }
}
